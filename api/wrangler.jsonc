// The Donedey API: accounts with passkeys, and sync for the web app.
// `database_id` is the id Cloudflare gave the `donedey` D1 database when it
// was created (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donedey-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Web pages allowed to call the API and sign in with a passkey. A
    // passkey belongs to the page's host name, so the GitHub Pages site and
    // localhost each get their own.
    "ALLOWED_ORIGINS": "https://claudey-codey.github.io,http://localhost:5173,http://localhost:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donedey",
      "database_id": "300c8c6e-5d4c-46cc-8b61-db215abb45c4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "donedey-files" }
  ]
}
